{
  "name": "V+Prep",
  "is_template": true,
  "args": [
    "$verb"
  ],
  "data": [
    {
      "e.g": "talk about/put on",
      "commands": [
        "[input] [Grammar:Verify:V] $verb B @Caller C",
        "[input] [Grammar:PrepositionPhrase:PlainPreposition] C [Verb] $verb @ B -> B",
        "[output] [Grammar:Verify:V] C @ $verb B -> yes",
        "[output] [Grammar:V:Verb] C @ $verb B -> $verb",
        "[output] [Grammar:V:Preposition] C @ $verb B -> B"
      ]
    },
    {
      "commands": [
        "[input] [Grammar:Verify:V] $verb B @Caller C",
        "[output] [Grammar:Verify:PrepositionPhrase] B @Caller C [Verb] $verb"
      ]
    }
  ]
}