{
  "dependencies": [
    "pronoun_resolver_object",
    "vp_set/V+IO+DO",
    "vp_set/V+O+OC",
    "vp_set/V+O",
    "vp_set/V+P",
    "vp_set/V",
    "vp_set/VP_Can"
  ],
  "data": [
    {
      "commands": [
        "[input] [Resolve:VP] A @Caller C",
        "[output] [Var:Resolve] A @Caller C [R]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [Var:Resolve] C [R] @ A -> A1",
        "[output] [Resolve:VP] C @ A -> A1",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [Var:Resolve] C [R] @ A ->",
        "[output] [repo] [GET] [GSave] [VP_Can:Can] A @Caller C [R]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [VP_Can:Can] A ->",
        "[output] [repo] [GET] [GSave] [By] A @Caller C [R]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A ->",
        "[output] [repo] [GET] [GSave] [Type] A @Caller C [R]"
      ]
    },
    {
      "commands": [
        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A -> D",
        "[output] [Var:Resolve] D @Caller C [VP_By]",
        "[output] [repo] [GET] [GSave] [VP] A @Caller C [R]",
        "[output] [repo] [GET] [GSave] [Prep] A @Caller C [R]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A -> D",
        "[input] [Var:Resolve] C [VP_By] @ D ->",
        "[output] [Resolve:O] D @Caller C [VP_By]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A -> D",
        "[input] [Var:Resolve] C [VP_By] @ D -> D1",
        "[output] [Resolve:O] C [VP_By] @ D -> D1",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A -> D",
        "[input] [repo] C [R] @ [GSave] [VP] A -> B",
        "[input] [Resolve:O] C [VP_By] @ D -> D1",
        "[output] [Var:Resolve] B @Caller C [VP_By]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [VP] A -> B",
        "[input] [Var:Resolve] C [VP_By] @ B ->",
        "[output] [Resolve:VP] B @Caller C [VP_By]",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [VP] A -> B",
        "[input] [Var:Resolve] C [VP_By] @ B -> B1",
        "[output] [Resolve:VP] C [VP_By] @ B -> B1",

        "[input] [Resolve:VP] A @Caller C",
        "[input] [repo] C [R] @ [GSave] [By] A -> D",
        "[input] [repo] C [R] @ [GSave] [VP] A -> B",
        "[input] [repo] C [R] @ [GSave] [Prep] A -> E",
        "[input] [Resolve:VP] C [VP_By] @ B -> B1",
        "[input] [Resolve:O] C [VP_By] @ D -> D1",
        "[output] [Resolve:VP] C @ A -> B1 E D1",
        "[output] [repo] [SSET] [GSave] [VP] B1 E D1 -> B1",
        "[output] [repo] [SSET] [GSave] [By] B1 E D1 -> D1",
        "[output] [repo] [SSET] [GSave] [Prep] B1 E D1 -> E"
      ]
    }
  ]
}
