{
  "dependencies": [
    "pronoun_resolver_object",
    "vp_set/V+IO+DO",
    "vp_set/V+O+OC",
    "vp_set/V+O",
    "vp_set/V+P",
    "vp_set/V",
    "vp_set/VP_Can"
  ],
  "data": [
    {
      "commands": [
        "[input] [Var:Resolve:VerbPhrase] A @Caller C",
        "[output] [Var:Resolve] A @Caller C",

        "[input] [Var:Resolve:VerbPhrase] A @Caller C",
        "[input] [Var:Resolve] C @ A -> A1",
        "[output] [Var:Resolve:VerbPhrase] C @ A -> A1",

        "[input] [Var:Resolve:VerbPhrase] A @Caller C",
        "[input] [Var:Resolve] C @ A ->",
        "[output] [Grammar:Verify:VerbPhrase] A @Caller C [Var]"
      ]
    },
    {
      "commands": [
        "[input] [Var:Resolve_Simplified:VerbPhrase] A @Caller C",
        "[output] [Var:Resolve] A @Caller C",

        "[input] [Var:Resolve_Simplified:VerbPhrase] A @Caller C",
        "[input] [Var:Resolve] C @ A -> A1",
        "[output] [Var:Resolve:VerbPhrase] C @ A -> A1"
      ]
    },
    {
      "commands": [
        "[input] [Grammar:VerbPhrase:By] C [Var] @ A -> D",
        "[output] [Var:Resolve:Object] D @Caller C [VP_By]",

        "[input] [Grammar:VerbPhrase:By] C [Var] @ A -> D",
        "[input] [Grammar:VerbPhrase:VP] C [Var] @ A -> B",
        "[input] [Var:Resolve:Object] C [VP_By] @ D -> D1",
        "[output] [Var:Resolve:VerbPhrase] B @Caller C [VP_By]",

        "[input] [Grammar:VerbPhrase:By] C [Var] @ A -> D",
        "[input] [Grammar:VerbPhrase:Prep] C [Var] @ A -> G",
        "[input] [Grammar:VerbPhrase:VP] C [Var] @ A -> B",
        "[input] [Var:Resolve:VerbPhrase] C [VP_By] @ B -> B1",
        "[input] [Var:Resolve:Object] C [VP_By] @ D -> D1",
        "[output] [Var:Resolve:VerbPhrase] C @ A -> B1 G D1",
        "[output] [repo] [SSET] [GSave] [VP] B1 G D1 -> B1",
        "[output] [repo] [SSET] [GSave] [By] B1 G D1 -> D1",
        "[output] [repo] [SSET] [GSave] [Prep] B1 G D1 -> G"
      ]
    },
    {
      "commands": [
        "[input] [Var:Resolve_Simplified:VerbPhrase] A @Caller C [S+VerbPhrase] E",
        "[input] [Var:Resolve] C [S+VerbPhrase] E @ A ->",
        "[input] [Grammar:VerbPhrase:By] C [Subject] @ A -> D",
        "[output] [Var:Resolve:Object] D @Caller C [VP_By]",

        "[input] [Var:Resolve_Simplified:VerbPhrase] A @Caller C [S+VerbPhrase] E",
        "[input] [Var:Resolve] C [S+VerbPhrase] E @ A ->",
        "[input] [Grammar:VerbPhrase:By] C [Subject] @ A -> D",
        "[input] [Grammar:VerbPhrase:VP] C [Subject] @ A -> B",
        "[input] [Var:Resolve:Object] C [VP_By] @ D -> D1",
        "[output] [Var:Resolve:VerbPhrase] B @Caller C [VP_By]",

        "[input] [Var:Resolve_Simplified:VerbPhrase] A @Caller C [S+VerbPhrase] E",
        "[input] [Var:Resolve] C [S+VerbPhrase] E @ A ->",
        "[input] [Grammar:VerbPhrase:By] C [Subject] @ A -> D",
        "[input] [Grammar:VerbPhrase:Prep] C [Var] @ A -> G",
        "[input] [Grammar:VerbPhrase:VP] C [Subject] @ A -> B",
        "[input] [Var:Resolve:VerbPhrase] C [VP_By] @ B -> B1",
        "[input] [Var:Resolve:Object] C [VP_By] @ D -> D1",
        "[output] [Var:Resolve:VerbPhrase] C [S+VerbPhrase] E @ A -> B1 G D1",
        "[output] [repo] [SSET] [GSave] [VP] B1 G D1 -> B1",
        "[output] [repo] [SSET] [GSave] [By] B1 G D1 -> D1",
        "[output] [repo] [SSET] [GSave] [Prep] B1 G D1 -> G"
      ]
    }
  ]
}
