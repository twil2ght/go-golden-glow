{
  "dependencies": [
    "pronoun_resolver_object",
    "vp_set/V+IO+DO",
    "vp_set/V+O+OC",
    "vp_set/V+O",
    "vp_set/V+P",
    "vp_set/V"
  ],
  "data": [
    {
      "commands": [
        "[input] [Var:Resolve:VerbPhrase] A @Caller C",
        "[output] [Grammar:Verify:VerbPhrase] A @Caller C [Var]"
      ]
    },
    {
      "commands": [
        "[input] [Grammar:VerbPhrase:By] C [Var] @ A -> D",
        "[output] [Var:Resolve] D @Caller C [VP_By]",

        "[input] [Grammar:VerbPhrase:By] C [Var] @ A -> D",
