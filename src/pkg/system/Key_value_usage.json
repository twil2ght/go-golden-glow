{
  "dependencies": [
    "key_value_verification/key/object",
    "key_value_verification/value/repo"
  ],
  "data":[
    {
      "commands": [
        "[input] [repo] C @ [No.] D [Cond] -> A is B",
        "[input] [System:Verify:Key] C @ A -> yes",
        "[input] [System:Verify:Value] C @ B -> yes",
        "[output] [template:Run] variable_toolkit @Args A , B @Caller C"
      ]
    },
    {
      "commands": [
        "[input] [repo] C @ [No.] D [Cond] -> A is B",
        "[output] [System:Verify:Key] A @Caller C",
        "[output] [System:Verify:Value] B @Caller C"
      ]
    },
    {
      "description": "Variety Projection:Subject",
      "commands": [
        "[input] [repo] C @ [No.] D [Cond] -> A",
        "[output] [Grammar:Verify:S+VerbPhrase] A @Caller C [Variety] [Cond]",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] @ A -> a B",
        "[output] [repo] [GET] [Variety] B @Caller C [Variety] [Cond]",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] @ A -> a B",
        "[input] [repo] C [Variety] [Cond] @ [Variety] B -> yes",
        "[output] [template:Run] variable_toolkit_2 @Args B @Caller C"
      ]
    },
    {
      "description": "Variety Projection:Object",
      "commands": [
        "[input] [repo] C @ [No.] D [Cond] -> A",
        "[output] [Grammar:Verify:S+VerbPhrase] A @Caller C [Variety] [Cond]",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] @ A -> B",
        "[input] [Grammar:S+VerbPhrase:VerbPhrase] C [Variety] [Cond] @ A -> E",
        "[input] [Grammar:VerbPhrase:V+O:Object] C [Variety] [Cond] [Subject] B @ E -> F",
        "[output] [repo] [GET] [Variety] F @Caller C [Variety] [Cond] [Subject] B [V+O] E",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] @ A -> B",
        "[input] [Grammar:S+VerbPhrase:VerbPhrase] C [Variety] [Cond] @ A -> E",
        "[input] [Grammar:VerbPhrase:V+O:Verb] C [Variety] [Cond] [Subject] B @ E -> F1",
        "[input] [Grammar:VerbPhrase:V+O:Object] C [Variety] [Cond] [Subject] B @ E -> F",
        "[input] [repo] C [Variety] [Cond] [Subject] B [V+O] E @ [Variety] F -> yes",
        "[output] [template:Run] variable_toolkit_3 @Args F , F1 , B @Caller C"
      ]
    },
    {
      "description": "Variety Projection:Say-EXl Object",
      "commands": [
        "[input] [repo] C @ [No.] D [Cond] -> A1 says : A",
        "[output] [Grammar:Verify:S+VerbPhrase] A @Caller C [Variety] [Cond] [SAY]",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] [SAY] @ A -> B",
        "[input] [Grammar:S+VerbPhrase:VerbPhrase] C [Variety] [Cond] [SAY] @ A -> E",
        "[input] [Grammar:VerbPhrase:V+O:Object] C [Variety] [Cond] [SAY] [Subject] B @ E -> a F",
        "[output] [repo] [GET] [Variety] F @Caller C [Variety] [Cond] [SAY] [Subject] B [V+O] E",

        "[input] [repo] C @ [No.] D [Cond] -> A1 says : A",
        "[input] [Grammar:S+VerbPhrase:Subject] C [Variety] [Cond] [SAY] @ A -> B",
        "[input] [Grammar:S+VerbPhrase:VerbPhrase] C [Variety] [Cond] [SAY] @ A -> E",
        "[input] [Grammar:VerbPhrase:V+O:Object] C [Variety] [Cond] [SAY] [Subject] B @ E -> a F",
        "[input] [Grammar:VerbPhrase:V+O:Verb] C [Variety] [Cond] [SAY] [Subject] B @ E -> F1",
        "[input] [repo] C [Variety] [Cond] [SAY] [Subject] B [V+O] E @ [Variety] F -> yes",
        "[output] [template:Run] variable_toolkit_4 @Args A1 , B , F1 , F @Caller C"
      ]
    }
  ]
}