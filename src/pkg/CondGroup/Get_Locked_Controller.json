{
  "dependencies": [
    "../SafeCalculate/plus_1",
    "../SafeCalculate/Minus_1"
  ],
  "API": [
    "[CondGroup:Get:Locked] [No.] {B} [of] {D} @Caller {C}"
  ],
  "callback": [
    "[CondGroup:Get:Locked:Done] [No.] {B} [of] {D} @Caller {C}"
  ],
  "repo": [
    "[CondGroup:Count:Locked] [No.] {B} [of] {D} -> F1",
    "[CondGroup:Get:Locked] [No.] {F} [of] [No.] {B} [of] {D} -> A"
  ],
  "args": {
    "B": "the index [of] the groups [of] D",
    "D": "the result [of] the group(also the group itself)",
    "C": "the caller (or the context)",
    "F1": "a number",
    "F": "the index [of] locked(not released) controller in the group",
    "A": " a controller"
  },
  "data": [
    {
      "description": "Get locked controllers",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] F1 @ [CondGroup] [No.] B1 [of] [No.] B [of] D -> A",
        "[input] [repo] C [CondGroup:Get:Locked] @ [CondGroup:DoneState] [of] A for [No.] B [of] D -> yes",
        "[input] [repo] C [No.] B1 @ [CondGroup:Count:Locked] [No.] B [of] D -> F",
        "[output] [repo] [SET] [CondGroup:Get:Locked] [No.] F [of] [No.] B [of] D -> A",
        "[output] [safe++] [CondGroup:Count:Locked] [No.] B [of] D @Caller C [No.] B1"
      ]
    },
    {
      "description": "Get locked controllers:init",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[output] [repo] [GET] [CondGroup] [No.] 1 [of] [No.] B [of] D @Caller C [No.] 0"
      ]
    },
    {
      "description": "Get locked controllers:Get [CondGroup:DoneState]",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] F1 @ [CondGroup] [No.] B1 [of] [No.] B [of] D -> A",
        "[output] [repo] [GET] [CondGroup:DoneState] [of] A for [No.] B [of] D @Caller C [CondGroup:Get:Locked]"
      ]
    },
    {
      "description": "Get locked controllers:Get [CondGroup:Count:Locked] if [CondGroup:DoneState] == no",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] F1 @ [CondGroup] [No.] B1 [of] [No.] B [of] D -> A",
        "[input] [repo] C [CondGroup:Get:Locked] @ [CondGroup:DoneState] [of] A for [No.] B [of] D -> no",
        "[output] [repo] [GET] [CondGroup:Count:Locked] [No.] B [of] D @Caller C [No.] B1"
      ]
    },
    {
      "description": "Get locked controllers:iterate",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] F1 @ [CondGroup] [No.] B1 [of] [No.] B [of] D -> A",
        "[input] [repo] C [CondGroup:Get:Locked] @ [CondGroup:DoneState] [of] A for [No.] B [of] D -> yes",
        "[output] [compute] B1 + 1 @Caller C [CondGroup:Get:Locked] [No.] B [of] D"
      ,
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] B1 @ [Latest] [CondGroup:Count:Locked] [No.] B [of] D -> F",
        "[output] [compute] B1 + 1 @Caller C [CondGroup:Get:Locked] [No.] B [of] D",

        "[input] C [CondGroup:Get:Locked] [No.] B [of] D @ [compute] F1 + 1 -> B1",
        "[output] [repo] [GET] [CondGroup] [No.] B1 [of] [No.] B [of] D @Caller C [No.] F1"
      ]
    },
    {
      "description": "Get locked controllers:Done",
      "commands": [
        "[input] [CondGroup:Get:Locked] [No.] B [of] D @Caller C",
        "[input] [repo] C [No.] F1 @ [CondGroup] [No.] B1 [of] [No.] B [of] D ->",
        "[output] [CondGroup:Get:Locked:Done] [No.] B [of] D @Caller C"
      ]
    }
  ]
}