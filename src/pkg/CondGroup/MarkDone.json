{
  "dependencies": [
    "../SafeCalculate/Minus_1"
  ],
  "data": [
    {
      "description": "Callback",
      "commands": [
        "[input] [repo] C @@ A @ [Latest] [Count] [of] [No.] B [CondGroup] [of] D -> F",
        "[output] [CondGroup:MarkDone:NewCount] C @ [No.] B [of] D @@ A -> F"
      ]
    },
    {
      "description": "Mark CondGroup as Done",
      "commands": [
        "[input] [CondGroup:Done] [No.] B [of] D @@ A @Caller C",
        "[input] [repo] C @ [CondGroup:DoneState] [of] A for [No.] B [of] D ->",
        "[output] [safe--] [Count] [of] [No.] B [CondGroup] [of] D @Caller C @@ A",
        "[output] [repo] [SSET] [CondGroup:DoneState] [of] A for [No.] B [of] D -> yes"
      ],
      "tip": "you haven't initialize the condGroup count,so you can't use [safe--]"
    },
    {
      "commands": [
        "[input] [repo] C @@ A @ [Count] [of] [No.] B [CondGroup] [of] D ->",
        "[output] [repo] [GET] [CondGroup:ElementCount] [No.] B [of] D @Caller C @@ A",

        "[input] [repo] C @@ A @ [Count] [of] [No.] B [CondGroup] [of] D ->",
        "[input] [repo] C @@ A @ [CondGroup:ElementCount] [No.] B [of] D -> F",
        "[output] [repo] C @@ A @ [Count] [of] [No.] B [CondGroup] [of] D -> F"
      ]
    },
    {
      "description": "Check if CondGroup is Done",
      "commands": [
        "[input] [CondGroup:Done] [No.] B [of] D @@ A @Caller C",
        "[output] [repo] [GET] [CondGroup:DoneState] [of] A for [No.] B [of] D @Caller C"
      ]
    },
    {
      "description": "Mark CondGroup as Done Automatically",
      "commands": [
        "[input] [CondGroup:DoneAuto] D @@ A @Caller C",
        "[input] [repo] C @ [CondGroup:Index] D [of] A -> B | F",
        "[output] [CondGroup:Done] [No.] B [of] D @@ A @Caller C"
      ]
    },
    {
      "description": "Get CondGroup Done Index",
      "commands": [
        "[input] [CondGroup:DoneAuto] D @@ A @Caller C",
        "[output] [repo] [GET] [CondGroup:Index] D [of] A @Caller C"
      ]
    },
    {
      "description": "Mark CondGroup as Undone Automatically",
      "commands": [
        "[input] [CondGroup:UndoneAuto] D @@ A @Caller C",
        "[input] [repo] C @ [CondGroup:Index] D [of] A -> B | F",
        "[output] [CondGroup:Undone] [No.] B [of] D @@ A @Caller C"
      ]
    },
    {
      "description": "Get CondGroup Index",
      "commands": [
        "[input] [CondGroup:UndoneAuto] D @@ A @Caller C",
        "[output] [repo] [GET] [CondGroup:Index] D [of] A @Caller C"
      ]
    },
    {
      "description": "Undo CondGroup",
      "commands": [
        "[input] [CondGroup:Undone] [No.] B [of] D @@ A @Caller C",
        "[input] [repo] C @ [CondGroup:DoneState] [of] A for [No.] B [of] D -> yes",
        "[output] [safe++] [Count] [of] [No.] B [CondGroup] [of] D @Caller C @@ A",
        "[output] [repo] [DEL] [CondGroup:DoneState] [of] C for [No.] B [of] D"
      ]
    },
    {
      "description": "Check if CondGroup is done",
      "commands": [
        "[input] [CondGroup:Undone] [No.] B [of] D @@ A @Caller C",
        "[output] [repo] [GET] [CondGroup:DoneState] [of] A for [No.] B [of] D @Caller C"
      ]
    }
  ]
}