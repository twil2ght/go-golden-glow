{
  "dependencies": [
    "pronoun_resolver_VP"
  ],
  "API": [
    "[Pronoun:Resolve] A @Caller C",
    "[Pronoun:ResolveCondition] A @Caller C"
  ],
  "callback": [
    "[Pronoun:Resolved] B @Caller C",
    "[Pronoun:ConditionResolved] B @Caller C"
  ],
  "data": [
    {
      "description": "two cases: subject is pronoun; subject is not pronoun",
      "commands": [
        "[input] [Pronoun:Resolve:Sentence:S+VerbPhrase] A @Caller C",
        "[output] [Grammar:Verify:S+VerbPhrase] A @Caller C [Pronoun]",

        "[input] [Grammar:S+VerbPhrase:Subject] C [Pronoun] @ A -> B",
        "[input] [Grammar:S+VerbPhrase:VerbPhrase] C [Pronoun] @ A -> E",
        "[output] [Pronoun:Resolve:Sentence:Object] B @Caller C [Pronoun] [S+VerbPhrase] A",
        "[output] [Pronoun:Resolve:Sentence:VerbPhrase] E @Caller C [Pronoun] [S+VerbPhrase] A [Subject] B",


        "IF SUBJECT CHANGED TO THIRD_SINGULAR,THEN SO WOULD THE VERB",
        "[input] [Pronoun:Resolve:Sentence:VerbPhrase] C [Pronoun] [S+VerbPhrase] A [Subject] B @ E -> E1",
        "[input] [Pronoun:Resolve:Sentence:Object] C [Pronoun] [S+VerbPhrase] A @ B -> B1",
        "[output] [Pronoun:Resolve:Sentence:S+VerbPhrase] C @ A -> B1 E1"
      ]
    }
  ]
}
