{
  "dependencies": [
    "pronoun_resolver_S+VP",
    "pronoun_resolver"
  ],
  "data": [
    {
      "commands": [
        "[input] [Pronoun:Resolve:Sentence:Conj+S+VerbPhrase] A @Caller C",
        "[output] [Grammar:Verify:Conj+S+VerbPhrase] A @Caller C [Pronoun]",

        "[input] [Grammar:Conj+S+VerbPhrase:Conjunction] C [Pronoun] @ A -> F",
        "[input] [Grammar:Conj+S+VerbPhrase:S+VerbPhrase] C [Pronoun] @ A -> E",
        "[output] [Pronoun:Resolve_Simplified:S+VerbPhrase] E @Caller C [Conj] F [Pronoun]",

        "[input] [Pronoun:Resolve:Sentence:S+VerbPhrase] C [Conj] F [Pronoun] @ E -> E1",
        "[output] [Pronoun:Resolve:Sentence:Conj+S+VerbPhrase] C @ F E -> F E1"
      ]
    }
  ]
}
