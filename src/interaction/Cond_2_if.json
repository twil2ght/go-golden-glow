{
  "dependencies": [
    "../pkg/Pronoun/pronoun_resolver",
    "../pkg/Pronoun/pronoun_resolver_Conj+S+VP"
  ],
  "data": [
    {
      "commands": [
        "[input] [Legal] C says to Susie : if A",
        "[input] [TeachMode] [if+] @ Teacher C -> yes",
        "[input] [Pronoun:Resolve:Sentence:S+VerbPhrase] [if+] @ A -> B",
        "[output] [Cond:Add] B @Caller [if+]",
        "[output] [Cond&Res:Add] B # [Cond:If] @Caller [if+]"
      ]
    },
    {
      "commands":[
        "[input] [Legal] C says to Susie : if A",
        "[output] [TeachMode:Check] Teacher C @Caller [if+]",
        "[output] [Pronoun:Resolve:Sentence:S+VerbPhrase] A @Caller [if+]"
      ]
    }
  ]
}
