{
  "dependencies": [
    "SafeCalculate"
  ],
  "API": [
    "[CondGroup:Done] No. B of D @Caller C",
    "[CondGroup:Undone] No. B of D @Caller C",
    "[CondGroup:DoneAuto] D @Caller C",
    "[CondGroup:UndoneAuto] D @Caller C"
  ],
  "data": [
    {
      "description": "CondGroup Activated",
      "commands": [
        "[input] [repo] C @ [Latest] Count of No. B [CondGroup] of D -> 0",
        "[output] D"
      ]
    },
    {
      "description": "Mark CondGroup as Done",
      "commands": [
        "[input] [CondGroup:Done] No. B of D @Caller C",
        "[input] [repo] [CondGroup:DoneState] of C for No. B of D -> no",
        "[output] [safe--] Count of No. B [CondGroup] of D @Caller C",
        "[output] [repo] [SET] [CondGroup:DoneState] of C for No. B of D -> yes"
      ]
    },
    {
      "description": "Check if CondGroup is Done",
      "commands": [
        "[input] [CondGroup:Done] No. B of D @Caller C",
        "[output] [repo] [GET] [CondGroup:DoneState] of C for No. B of D"
      ]
    },
    {
      "description": "route:null->no",
      "commands":[
        "[input] [repo] [CondGroup:DoneState] of C for No. B of D ->",
        "[output] [repo] [CondGroup:DoneState] of C for No. B of D -> no"
      ]
    },
    {
      "description": "Mark CondGroup as Done Automatically",
      "commands": [
        "[input] [CondGroup:DoneAuto] D @Caller C",
        "[input] [repo] [CondGroup:Index] of D for C -> B",
        "[output] [CondGroup:Done] No. B of D @Caller C"
      ]
    },
    {
      "description": "Get CondGroup Done Index",
      "commands": [
        "[input] [CondGroup:DoneAuto] D @Caller C",
        "[output] [repo] [GET] [CondGroup:Index] of D for C"
      ]
    },
    {
      "description": "Mark CondGroup as Undone Automatically",
      "commands": [
        "[input] [CondGroup:UndoneAuto] D @Caller C",
        "[input] [repo] [CondGroup:Index] of D for C -> B",
        "[output] [CondGroup:Undone] No. B of D @Caller C"
      ]
    },
    {
      "description": "Get CondGroup Index",
      "commands": [
        "[input] [CondGroup:UndoneAuto] D @Caller C",
        "[output] [repo] [GET] [CondGroup:Index] of D for C"
      ]
    },
    {
      "description": "Undo CondGroup",
      "commands": [
        "[input] [CondGroup:Undone] No. B of D @Caller C",
        "[input] [repo] [CondGroup:DoneState] of C for No. B of D -> yes",
        "[output] [safe++] Count of No. B [CondGroup] of D @Caller C",
        "[output] [repo] [DEL] [CondGroup:DoneState] of C for No. B of D"
      ]
    },
    {
      "description": "Check if CondGroup is done",
      "commands": [
        "[input] [CondGroup:Undone] No. B of D @Caller C",
        "[output] [repo] [GET] [CondGroup:DoneState] of C for No. B of D"
      ]
    }
  ]
}