{
  "dependencies": [
    "SafeCalculate"
  ],
  "description": "CondGroup:Iterator",
  "data": [
    {
      "commands": [
        "[input] [repo] No. F [Cond] -> A",
        "[input] [repo] [Res] -> D",
        "[input] [repo] Latest Len of [CondGroup] of D -> B",
        "[output] [safe++] Len of NO. B [CondGroup] of D",
        "[output] [repo] set Then what? A -> [safe--] Count of NO. B [CondGroup] of D"
      ]
    },
    {
      "description": "iterate",
      "commands": [
        "[input] [repo] No. F [Cond] -> A",
        "[input] [repo] [Res] -> D",
        "[output] [compute] get F + 1",

        "[input] [repo] No. F [Cond] -> A",
        "[input] [repo] [Res] -> D",
        "[input] [compute] F + 1 -> F1",
        "[output] [repo] get No. F1 [Cond]"
      ]
    },
    {
      "description": "checks",
      "commands": [
        "[input] [repo] [Res] -> D",
        "[output] [safe++] Len of [CondGroup] of D",
        "[output] [repo] get No. 1 [Cond]"
      ]
    }
  ]
}